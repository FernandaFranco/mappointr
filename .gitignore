# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead: `~/.gitignore_global`

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids
/tmp/pids/*
!/tmp/pids/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets built by the asset pipeline / tailwindcss-rails.
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key
/config/credentials/*.key

# Local environment variables (see .env.example for the expected keys).
.env
.env.*
!.env.example

# Editor / tooling caches.
/.ruby-lsp
/node_modules
.byebug_history

# System test artifacts.
/tmp/screenshots

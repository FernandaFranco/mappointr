<div class="mt-6 space-y-2 text-center text-sm">
  <%- if controller_name != 'sessions' %>
    <%= link_to "Já tem uma conta? Entrar", new_session_path(resource_name),
        class: "block text-red-600 hover:text-red-700 font-medium transition" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "Não tem conta? Criar conta", new_registration_path(resource_name),
        class: "block text-red-600 hover:text-red-700 font-medium transition" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Esqueceu a senha?", new_password_path(resource_name),
        class: "block text-gray-500 hover:text-gray-700 transition" %>
  <% end %>
</div>

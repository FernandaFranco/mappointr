<%# Placar final — variáveis: room %>

<div class="bg-white rounded-lg shadow-lg p-6 text-center">
  <div class="text-5xl mb-2">🏆</div>
  <h2 class="text-2xl font-bold text-gray-900 mb-6">Fim de jogo!</h2>

  <ol class="space-y-2 mb-6 text-left">
    <% room.room_players.includes(:user).order(score: :desc).each_with_index do |room_player, index| %>
      <li class="flex items-center justify-between rounded-lg px-4 py-3 <%= index.zero? ? "bg-yellow-50 border border-yellow-200" : "bg-gray-50" %>">
        <span class="text-gray-800">
          <%= index + 1 %>º — <%= room_player.user.display_name %>
          <% if index.zero? %><span class="ml-1">🥇</span><% end %>
        </span>
        <span class="font-bold text-gray-900"><%= room_player.score %> pts</span>
      </li>
    <% end %>
  </ol>

  <%= link_to "Criar outra sala", new_room_path,
      class: "block w-full text-center bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-4 rounded-lg transition duration-150" %>
</div>

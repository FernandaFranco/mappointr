<%# Lista de jogadores na sala de espera — variáveis: room %>

<ul class="space-y-2">
  <% room.players.each do |player| %>
    <li class="flex items-center justify-between bg-gray-50 rounded-lg px-4 py-2">
      <span class="text-sm text-gray-800"><%= player.email %></span>
      <% if player.id == room.host_id %>
        <span class="text-xs bg-yellow-100 text-yellow-800 px-2 py-0.5 rounded-full">Host</span>
      <% end %>
    </li>
  <% end %>
</ul>
<p class="text-xs text-gray-400 mt-2"><%= room.room_players.count %> jogador(es) na sala (máximo <%= Room::MAX_PLAYERS %>)</p>

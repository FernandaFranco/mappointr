<%# Rodada em andamento numa sala — variáveis: room, room_round %>
<%# ATENÇÃO: este partial é usado tanto por uma request normal (rooms#show)
    quanto renderizado fora de uma request via broadcast_replace_to (quando
    a rodada começa). Fora de uma request não existe usuário autenticado —
    não use current_user aqui. Quem já respondeu vê "_waiting_for_others"
    em vez deste partial (decidido em show.html.erb, que é sempre uma
    request normal). %>

<div class="bg-white rounded-lg shadow-lg p-6">
  <div class="flex items-center justify-between mb-4">
    <span class="text-sm text-gray-500">Rodada <%= room.current_round_number %> de <%= room.total_rounds %></span>

    <div data-controller="room-countdown"
         data-room-countdown-seconds-left-value="<%= [ (room_round.started_at + room.round_duration_seconds - Time.current).to_i, 0 ].max %>"
         data-room-countdown-advance-url-value="<%= advance_room_path(room) %>"
         class="text-sm font-mono text-gray-600">
      ⏱ <span data-room-countdown-target="display"></span>s
    </div>
  </div>

  <h2 class="text-xl font-semibold text-gray-800 text-center mb-4">
    Onde fica <span class="text-red-600 font-bold"><%= room_round.country.name_pt %></span>?
  </h2>

  <div id="map-container"
       class="w-full h-96 bg-gray-100 rounded-lg border-2 border-gray-300 relative"
       data-controller="map"
       data-map-country-id-value="<%= room_round.country.id %>"
       data-map-submit-url-value="<%= room_guesses_path(room) %>">
    <div class="absolute inset-0 flex items-center justify-center text-center text-gray-500" data-map-target="placeholder">
      <div>
        <p class="text-lg">Carregando mapa...</p>
      </div>
    </div>
  </div>

  <div id="room_progress" class="mt-4">
    <%= render "rooms/progress", room_round: room_round %>
  </div>
</div>
